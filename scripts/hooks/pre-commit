#!/bin/sh
# XUQIAN 提交前校验。
#
# 由 scripts/install-hooks.mjs 复制到 .git/hooks/pre-commit（不随仓库版本化，
# 因为 .git/ 本身不进版本库）。
#
# 设计取舍：这里**只跑快且确定性的检查**（数字守卫 + 类型检查 + 单元测试，约 4 秒）。
# 故意不跑 `pnpm test:all`——它包含需要真实浏览器和开发服务器的冒烟测试，
# 放进钩子会让每次提交都卡住；那类检查留给 `pnpm test:all`。
# 也故意不跑 prettier/eslint：格式重排应当是一次独立提交（见 CHANGELOG），
# 在钩子里自动改文件会让提交内容变得不可预期。
#
# 需要临时绕过时用：git commit --no-verify

set -e

if ! command -v node >/dev/null 2>&1; then
  echo "[pre-commit] 找不到 node，跳过校验（请自行确认改动）。"
  exit 0
fi

if [ ! -d node_modules ]; then
  echo "[pre-commit] node_modules 不存在，跳过校验（先跑 pnpm install）。"
  exit 0
fi

echo "[pre-commit] 1/3 文档数字守卫 ..."
node scripts/check-counts.mjs

echo "[pre-commit] 2/3 类型检查 ..."
node node_modules/typescript/bin/tsc -p tsconfig.app.json --noEmit

echo "[pre-commit] 3/3 单元测试 ..."
node node_modules/vitest/vitest.mjs run --silent

echo "[pre-commit] 全部通过。"
